### ---preamble--- ###
units micro 
atom_style hybrid dipole sphere bond 
boundary p p s

neighbor 1.0 bin 
#neigh_modify every 1 delay 1 check yes
pair_style lj/cut/dipole/cut 1 20 

### ---Variables--- ###
## Simulation box calculation
variable natoms equal 150
variable radius equal 1.4
variable boxlen2 equal sqrt(PI * v_radius^2 *v_natoms / ${packing})/2

## magnetic dipole prefactor
variable mu0 equal 4*PI*1e-10 
variable c equal 2.99792e8
variable chi equal 0.4
variable V equal 4/3*PI*v_radius^3
variable pref equal v_V * v_chi / v_mu0 / v_c

## Bmag can be made dynamic
variable Bmag equal 7.28e-6 # pg/us/pC
variable theta atom 0.471238898
variable phi atom 0.0

## the prefactor is evaluated using ${} to ensure preeval.
variable dipole atom ${pref} * v_Bmag

### ---Create Particles and Region--- ###
region 1 block -${boxlen2} ${boxlen2} -${boxlen2} ${boxlen2} -0.1 0.1

create_box 1 1 
create_atoms 1 random 150 1235 NULL
pair_coeff 1 1 0.01 2.49451641079295 2.8 20
group Atoms type 1 
mass * 1

minimize 1.0e-4 1.0e-6 100 1000

### Calculate instantaneous field 

variable mx atom v_dipole*cos(${frequency}*time*2*PI+v_phi)*sin(v_theta)
variable my atom v_dipole*sin(${frequency}*time*2*PI+v_phi)*sin(v_theta)
variable mz atom v_dipole*cos(v_theta)

set group all dipole v_mx v_my v_mz

### ---Fixes--- ###

#fix 	1 Atoms setdipole v_fieldx v_fieldy v_fieldz 0
fix 	1 Atoms set 1 0 group all dipole v_mx v_my v_mz

#fix 	2 Atoms brownian 300 921259 gamma_t 0.001
fix 	2 Atoms brownian 300 92125 gamma_t 56.739 

#fix     3 Atoms addforce 0 0 -0.00011264159515495175 
fix 	6 Atoms wall/lj126 zlo -2.0 0.01 1.247258205396475  1.4 zhi 2.0 0.01 1.247258205396475  1.4  

### ---Run Commands--- ###
timestep 	100.0 
dump 	3 all custom 100 test.lammpstrj id type x	 y	 z mux muy muz
thermo_style 	custom step atoms
thermo 	100  
run 	1000000 
