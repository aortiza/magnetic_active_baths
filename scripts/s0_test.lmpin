### ---preamble--- ###
# log ./data/script0/test.log
units micro 
atom_style hybrid dipole sphere bond 
boundary p p s

neighbor 0.1 nsq 
#neigh_modify every 1 delay 1 check yes
pair_style lj/cut/dipole/cut 1 20 

### ---Create Particles and Region--- ###
region 1 block -27 27 -27 27 -0.1 0.1

create_box 2 1 
create_atoms 1 single 0.0 0.0 0.0 
create_atoms 2 single 2.8 0.0 0.0 
pair_coeff * * 0.01 2.49451641079295 2.8 20
group motile type 2 
mass * 1

### ---Variables--- ###

## magnetic dipole prefactor
variable radius equal 1.4
variable mu0 equal 4*PI*1e-10 
variable c equal 2.99792e8
variable chi equal 0.4
variable V equal 4/3*PI*v_radius^3
variable pref equal v_V * v_chi / v_mu0 / v_c

## Bmag can be made dynamic
variable Bmag equal 1e-6 # pg/us/pC

## the prefator is evaluated using ${} to ensure preeval.
variable dipole atom ${pref} * v_Bmag

set group all dipole 0.0 0.0 v_dipole

### ---Fixes--- ###
fix 1 motile move linear 0.0001 0.0 0.0

### ---Run Commands--- ###
timestep 	100.0 
dump 	3 all custom 1 test.lammpstrj id type x	 y	 z muz fx
thermo_style 	custom step atoms
thermo 	100  
run 	1000 
